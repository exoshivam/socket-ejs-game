<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lakadia - Game Results</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=Poppins:wght@300;400;500;600;700;800&display=swap');
        
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            overflow-x: hidden;
        }
        
        .game-title {
            font-family: 'Cinzel', serif;
            background: linear-gradient(135deg, #ffd700, #ffed4e, #ffd700);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .results-container {
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(10px);
        }
        
        .trophy-animation {
            animation: bounce 1s ease-in-out infinite;
        }
        
        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-20px); }
        }
        
        .confetti {
            position: fixed;
            width: 10px;
            height: 10px;
            background: #ffd700;
            animation: confetti-fall 3s linear infinite;
        }
        
        @keyframes confetti-fall {
            to {
                transform: translateY(100vh) rotate(360deg);
                opacity: 0;
            }
        }
        
        .podium {
            display: flex;
            align-items: flex-end;
            justify-content: center;
            gap: 15px;
            margin: 30px 0;
        }
        
        .podium-step {
            display: flex;
            flex-direction: column;
            align-items: center;
            animation: popIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        
        @keyframes popIn {
            0% { 
                opacity: 0;
                transform: scale(0.5) translateY(40px);
            }
            100% {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }
        
        .podium-step:nth-child(1) { animation-delay: 0.3s; }
        .podium-step:nth-child(2) { animation-delay: 0s; }
        .podium-step:nth-child(3) { animation-delay: 0.6s; }
        
        .podium-base {
            width: 100%;
            border-radius: 8px 8px 0 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: white;
            font-size: 20px;
            padding: 10px;
        }
        
        .first-podium { 
            height: 120px;
            background: linear-gradient(180deg, #ffd700 0%, #ffed4e 100%);
            color: #333;
        }
        .second-podium { 
            height: 90px;
            background: linear-gradient(180deg, #c0c0c0 0%, #e8e8e8 100%);
            color: #333;
        }
        .third-podium { 
            height: 70px;
            background: linear-gradient(180deg, #cd7f32 0%, #e8a76a 100%);
            color: #fff;
        }
        
        .rank-avatar {
            font-size: 2.5rem;
            margin-bottom: 4px;
        }
        
        .rank-name {
            font-size: 0.9rem;
            font-weight: 700;
            color: inherit;
            text-overflow: ellipsis;
            overflow: hidden;
            white-space: nowrap;
            max-width: 100px;
        }
        
        .rank-score {
            font-size: 1.3rem;
            font-weight: 800;
            margin-top: 4px;
        }
        
        .winner-card {
            background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
            box-shadow: 0 8px 30px rgba(255, 215, 0, 0.3);
            border: 2px solid rgba(255, 215, 0, 0.5);
        }
        
        .second-place {
            background: linear-gradient(135deg, #e8e8e8 0%, #f5f5f5 100%);
            border: 2px solid #c0c0c0;
        }
        
        .third-place {
            background: linear-gradient(135deg, #e8a76a 0%, #f0c896 100%);
            border: 2px solid #cd7f32;
        }
        
        .fourth-place {
            background: white;
            border: 2px solid #e2e8f0;
        }
        
        .stat-card {
            background: white;
            border: 2px solid #e2e8f0;
            transition: all 0.3s ease;
        }
        
        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            border-color: #667eea;
        }
        
        .action-button {
            transition: all 0.3s ease;
        }
        
        .action-button:hover {
            transform: scale(1.05);
        }
        
        .replay-button {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            box-shadow: 0 4px 15px rgba(245, 87, 108, 0.4);
            color: white;
        }
        
        .replay-button:hover {
            box-shadow: 0 6px 25px rgba(245, 87, 108, 0.6);
        }
        
        .leave-button {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            box-shadow: 0 4px 15px rgba(79, 172, 254, 0.4);
            color: white;
        }
        
        .leave-button:hover {
            box-shadow: 0 6px 25px rgba(79, 172, 254, 0.6);
        }
        
        .sparkle {
            animation: sparkle 1.5s ease-in-out infinite;
        }
        
        @keyframes sparkle {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.5; transform: scale(1.2); }
        }
    </style>
</head>
<body class="flex items-center justify-center p-4">
    <div id="confetti-container"></div>
    
    <div class="results-container rounded-3xl shadow-2xl w-full max-w-4xl p-6 sm:p-8 relative overflow-hidden">
        <div class="text-center mb-6">
            <div class="trophy-animation text-7xl sm:text-8xl mb-4">🏆</div>
            <h1 class="game-title text-4xl sm:text-5xl font-black mb-2">GAME COMPLETE!</h1>
            <p class="text-gray-600 text-lg">Final Rankings</p>
        </div>
        
        <% if (rankedPlayers && rankedPlayers.length >= 3) { %>
            <div class="podium">
                <div class="podium-step">
                    <div class="text-center mb-2">
                        <div style="font-size: 2rem; margin-bottom: 6px;">🥈</div>
                        <div style="font-weight: 700; font-size: 0.8rem; color: #555;">2ND</div>
                    </div>
                    <div class="podium-base second-podium">
                        <div class="rank-avatar"><%= rankedPlayers[1].avatar %></div>
                        <div class="rank-name"><%= rankedPlayers[1].name %></div>
                        <div class="rank-score" style="color: #333;"><%= rankedPlayers[1].totalScore.toFixed(1) %></div>
                    </div>
                </div>
                
                <div class="podium-step">
                    <div class="text-center mb-2">
                        <div style="font-size: 2rem; margin-bottom: 6px;" class="sparkle">👑</div>
                        <div style="font-weight: 700; font-size: 0.8rem; color: #555;">WINNER</div>
                    </div>
                    <div class="podium-base first-podium">
                        <div class="rank-avatar"><%= rankedPlayers[0].avatar %></div>
                        <div class="rank-name"><%= rankedPlayers[0].name %></div>
                        <div class="rank-score"><%= rankedPlayers[0].totalScore.toFixed(1) %></div>
                    </div>
                </div>
                
                <div class="podium-step">
                    <div class="text-center mb-2">
                        <div style="font-size: 2rem; margin-bottom: 6px;">🥉</div>
                        <div style="font-weight: 700; font-size: 0.8rem; color: #555;">3RD</div>
                    </div>
                    <div class="podium-base third-podium">
                        <div class="rank-avatar"><%= rankedPlayers[2].avatar %></div>
                        <div class="rank-name"><%= rankedPlayers[2].name %></div>
                        <div class="rank-score"><%= rankedPlayers[2].totalScore.toFixed(1) %></div>
                    </div>
                </div>
            </div>
        <% } %>
        
        <div class="space-y-3 mb-8">
            <% rankedPlayers.forEach((player, index) => { %>
                <% 
                    let cardClass = 'fourth-place';
                    let medal = '';
                    let position = (index + 1) + 'th';
                    
                    if (index === 0) {
                        cardClass = 'winner-card';
                        medal = '🥇';
                        position = '1st';
                    } else if (index === 1) {
                        cardClass = 'second-place';
                        medal = '🥈';
                        position = '2nd';
                    } else if (index === 2) {
                        cardClass = 'third-place';
                        medal = '🥉';
                        position = '3rd';
                    }
                %>
                <div class="<%= cardClass %> rounded-2xl p-4 sm:p-5">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3 sm:gap-4">
                            <div class="text-4xl sm:text-5xl"><%= player.avatar %></div>
                            <div>
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="text-xl sm:text-2xl font-bold"><%= position %></span>
                                    <span class="text-lg"><%= medal %></span>
                                </div>
                                <div class="font-bold text-base sm:text-lg text-gray-800"><%= player.name %></div>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="text-3xl sm:text-4xl font-black text-purple-600"><%= player.totalScore.toFixed(1) %></div>
                            <div class="text-xs text-gray-600">points</div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
        
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
            <div class="stat-card rounded-xl p-4 text-center">
                <div class="text-3xl mb-2">⏱️</div>
                <div class="text-2xl font-bold text-purple-600"><%= gameTime %></div>
                <div class="text-xs text-gray-600">Game Time</div>
            </div>
            
            <div class="stat-card rounded-xl p-4 text-center">
                <div class="text-3xl mb-2">🔄</div>
                <div class="text-2xl font-bold text-purple-600">5</div>
                <div class="text-xs text-gray-600">Total Rounds</div>
            </div>
            
            <div class="stat-card rounded-xl p-4 text-center">
                <div class="text-3xl mb-2">🎴</div>
                <div class="text-2xl font-bold text-purple-600"><%= cardsPlayed %></div>
                <div class="text-xs text-gray-600">Cards Played</div>
            </div>
            
            <div class="stat-card rounded-xl p-4 text-center">
                <div class="text-3xl mb-2">🎯</div>
                <div class="text-2xl font-bold text-purple-600"><%= yourWins %></div>
                <div class="text-xs text-gray-600">Your Wins</div>
            </div>
        </div>
        
        <div class="space-y-3">
            <button class="replay-button action-button w-full py-4 rounded-xl font-bold text-lg shadow-lg" onclick="playAgain()">
                🔄 Play Again
            </button>
            
            <button class="leave-button action-button w-full py-3 rounded-xl font-semibold shadow-lg" onclick="leaveRoom()">
                🚪 Leave Room
            </button>
        </div>
        
        <div class="mt-6 text-center">
            <p class="text-sm text-gray-600">Room Code: <span class="font-mono font-bold text-purple-600"><%= roomId %></span></p>
            <p class="text-xs text-gray-500 mt-2">Thanks for playing Lakadia! 🎮</p>
        </div>
    </div>
    
    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const roomId = urlParams.get('roomId');
        
        function createConfetti() {
            const container = document.getElementById('confetti-container');
            const colors = ['#ffd700', '#ff6b6b', '#4ecdc4', '#45b7d1', '#f093fb', '#4facfe'];
            
            for (let i = 0; i < 50; i++) {
                const confetti = document.createElement('div');
                confetti.className = 'confetti';
                confetti.style.left = Math.random() * 100 + '%';
                confetti.style.background = colors[Math.floor(Math.random() * colors.length)];
                confetti.style.animationDelay = Math.random() * 3 + 's';
                confetti.style.animationDuration = (Math.random() * 2 + 2) + 's';
                container.appendChild(confetti);
            }
        }
        
        window.addEventListener('load', createConfetti);
        
        function playAgain() {
            if (confirm('Start a new game with the same players?')) {
                console.log('Restarting game...');
                if (roomId) {
                    window.location.href = `/waiting-room?roomId=${roomId}&replay=true`;
                } else {
                    window.location.href = '/waiting-room';
                }
            }
        }
        
        function leaveRoom() {
            if (confirm('Are you sure you want to leave this room?')) {
                console.log('Leaving room...');
                window.location.href = '/';
            }
        }
    </script>
</body>
</html>
